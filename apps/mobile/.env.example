EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_API_URL=https://your-api-url.example.com

# Optional: "owner/repo" for automatic GitHub Releases native APK update prompts
EXPO_PUBLIC_GITHUB_REPO=

# Feature flags (enable Android FCM once google-services.json is placed in apps/mobile/)
EXPO_ENABLE_ANDROID_FCM=false
EXPO_ENABLE_IOS_VOIP=false
