PORT=3001
CORS_ORIGIN=http://localhost:8081

# Required (Supabase Free Tier)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Required (LiveKit Cloud Free Tier)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_AGENT_NAME=kallie-voice-agent

# Optional — Phase 3 Android Lock-Screen Push (Firebase FCM, Free)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional — Phase 4 iOS Lock-Screen Push (Apple APNs VoIP, requires Apple Developer Account)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.kallie.app
APNS_PRIVATE_KEY_PATH=./certs/AuthKey.p8
APNS_PRODUCTION=false
