{
  "name": "kallie",
  "version": "0.2.0",
  "private": true,
  "description": "Kallie — 100% Serverless Local-First AI Companion for Android (Expo + SQLite + Direct Gemini Live / OpenAI Realtime + Static Next.js Landing Page)",
  "scripts": {
    "install:all": "npm --prefix apps/web install && npm --prefix apps/bridge install && npm --prefix apps/mobile install --legacy-peer-deps",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:bridge": "npm --prefix apps/bridge run dev",
    "dev:mobile": "npm --prefix apps/mobile run start",
    "mobile:doctor": "npm --prefix apps/mobile run android:doctor",
    "mobile:build": "npm --prefix apps/mobile run android:build",
    "mobile:install-debug": "npm --prefix apps/mobile run android:install-debug",
    "mobile:dev": "npm --prefix apps/mobile run android:dev",
    "mobile:logs": "npm --prefix apps/mobile run android:logs",
    "mobile:mirror": "npm --prefix apps/mobile run android:mirror",
    "mobile:release-local": "npm --prefix apps/mobile run android:release-local",
    "build:web": "npm --prefix apps/web run build",
    "build:bridge": "npm --prefix apps/bridge run build",
    "test:bridge": "npm --prefix apps/bridge test",
    "typecheck:mobile": "npm --prefix apps/mobile run typecheck",
    "typecheck:all": "npm run build:web && npm run test:bridge && npm run typecheck:mobile"
  }
}
