# Root .env used by docker-compose.yml on AWS EC2
# Copy to repository root as `.env` on the server before running `docker compose up -d --build`

API_DOMAIN=api.yourdomain.com
WEB_DOMAIN=kallie.yourdomain.com

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
